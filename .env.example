# ==============================================================================
# AI COMPLIANCE PLATFORM — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development.
# For Vercel: Set variables under Project Settings > Environment Variables.
# For Render: Set variables under Dashboard > Service > Environment.
# For AWS: Set variables via AWS Systems Manager (SSM) or Lambda Environment.
#
# IMPORTANT: Never commit your real `.env.local` or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Next.js / Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Auth & Public Client (Browser-accessible)
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE CREDENTIALS (Next.js API Routes & Python Backend)
# ------------------------------------------------------------------------------
# Supabase Service Role / Secret Key (Used for permanent DB archival & Storage signed URLs)
# Copy from: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_service_role_secret_key_here

# Google Gemini API Key (Required for compliance classification)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# 3. UPSTASH REDIS (Rate Limiting, Circuit Breaker & Caching)
# ------------------------------------------------------------------------------
# Create a free Redis database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX_your_upstash_redis_token_here

# ------------------------------------------------------------------------------
# 4. BACKEND ROUTING & FAILOVER (Next.js Server Router)
# ------------------------------------------------------------------------------
# Failover routing mode:
# - 'auto': Checks Primary health, falls back to Secondary if Primary fails
# - 'secondary': Directs all traffic to Secondary (Render / local FastAPI)
# - 'primary': Directs all traffic to Primary (AWS API Gateway)
FAILOVER_MODE=auto

# Primary Backend: AWS API Gateway endpoint (leave blank if running purely on Render/Local)
PRIMARY_BACKEND_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Secondary Backend: FastAPI Service URL (Local: http://localhost:8000 | Render: https://your-app.onrender.com)
SECONDARY_BACKEND_URL=http://localhost:8000

# Shared Authorization Token (Secures communication between Next.js and Python backend)
# Must match in both Next.js (.env.local / Vercel) and Python backend (Render environment)
BACKEND_SHARED_TOKEN=your-random-32-char-shared-token-secret

# ------------------------------------------------------------------------------
# 5. PYTHON BACKEND SERVICE CONFIGURATION (Render / Docker / Local FastAPI)
# ------------------------------------------------------------------------------
PORT=8000
AUDIT_MODELS=gemini-2.5-flash
GEMINI_TIER=free
ALLOWED_ORIGIN=*
SUPABASE_STORAGE_BUCKET=audit-uploads
